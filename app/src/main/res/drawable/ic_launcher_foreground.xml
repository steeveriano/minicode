<!--
  Launcher foreground: three bars, longest first, with the smallest picked out in the accent
  colour.

  It reads as what the app is for — seeing what occupies the space, ranked — and the accent bar
  marks the one singled out for action rather than deleted.

  Drawn as a vector so it stays sharp at every density, and kept inside the adaptive-icon safe
  zone (roughly a 72dp circle centred in the 108dp viewport) because launchers mask the outer
  band and anything there can be cropped.

  Three solid forms with generous corner radii and wide spacing: this survives 48px, which is the
  size that decides whether an icon works. Nothing is outlined, gradiented, or detailed, because
  none of that resolves at that size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Largest consumer -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36.5,29.5 H71.5 A6.5,6.5 0 0 1 78,36 V36 A6.5,6.5 0 0 1 71.5,42.5 H36.5 A6.5,6.5 0 0 1 30,36 V36 A6.5,6.5 0 0 1 36.5,29.5 Z" />

    <!-- Second -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36.5,47.5 H57.5 A6.5,6.5 0 0 1 64,54 V54 A6.5,6.5 0 0 1 57.5,60.5 H36.5 A6.5,6.5 0 0 1 30,54 V54 A6.5,6.5 0 0 1 36.5,47.5 Z" />

    <!-- The one singled out -->
    <path
        android:fillColor="#00E676"
        android:pathData="M36.5,65.5 H42.5 A6.5,6.5 0 0 1 49,72 V72 A6.5,6.5 0 0 1 42.5,78.5 H36.5 A6.5,6.5 0 0 1 30,72 V72 A6.5,6.5 0 0 1 36.5,65.5 Z" />
</vector>
