# Publishable Supabase credentials, committed on purpose.
#
# These are not secrets. They name the project, not a person, and Vite inlines them into the
# JavaScript at build time — so they are readable by anyone who opens the deployed site whether or
# not they live here. Committing them removes a manual configuration step for zero added exposure.
#
# What protects the data is not this key: it is device_storage.viewers, an allowlist of verified
# email addresses checked server-side on every request. A stranger holding this key still gets null.
#
# NEVER commit the service-role key. That one bypasses row level security and belongs only in the
# environment of whoever runs `npm run capture`.
#
# Netlify environment variables of the same name still win over this file.
VITE_SUPABASE_URL=https://fqrrcoupmwssqbatgxrs.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UL-50rm20qc6giZqC18ROA_LA5XyqCZ
